+static __u32 ksu_sulog_copy_filename_kernel(const char *filename, char *dst, __u32 dst_len)
+{
+    long ret;
+
+    if (!dst_len)
+        return 0;
+
+    if (!filename)
+        return ksu_sulog_copy_empty_string(dst);
+
+    ret = strncpy(dst, filename, dst_len);
+    if (ret <= 0)
+        return ksu_sulog_copy_empty_string(dst);
+
+    if (ret >= dst_len) {
+        dst[dst_len - 1] = '\0';
+        return dst_len;
+    }
+
+    return ret + 1;
+}
